# Render / local environment variables for Drexora AI
OPENROUTER_API_KEY=
OPENROUTER_API_URL=https://api.openrouter.ai/v1
FRONTEND_URL=http://localhost:3000
DEFAULT_AI_MODEL=gpt-4o-mini
AI_RATE_LIMIT_PER_MINUTE=60

# Firebase service account values (for Render only — keep these secret)
FIREBASE_PROJECT_ID=beastai-f0702
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n
NODE_ENV=production
PORT=10000
# Copy this file to .env for local development. Never commit the real .env file.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: use another OpenAI-compatible provider.
# OPENAI_BASE_URL=https://api.openai.com/v1
PORT=3000
# If you want the static frontend to use the AI backend without Firebase auth,
# set PUBLIC_CHAT=true (RENDER only; leaving this off requires clients to sign in)
PUBLIC_CHAT=false