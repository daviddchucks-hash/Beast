# Render / local environment variables for Drexora AI
OPENROUTER_API_KEY=
OPENROUTER_API_URL=https://api.openrouter.ai/v1
GEMINI_API_KEY=
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3.6-flash
# Free Gemini models (gemini-2.x are retired; only 3.x work)
GEMINI_FREE_MODELS=gemini-3.1-flash-lite,gemini-3.6-flash
# AI_PROVIDER: auto (try Gemini then OpenRouter), gemini, or openrouter
AI_PROVIDER=auto
FRONTEND_URL=https://daviddchucks-hash.github.io,https://drexora-ai.onrender.com
DEFAULT_AI_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Free OpenRouter models (verified July 2026 on openrouter.ai/models)
OPENROUTER_FREE_MODELS=meta-llama/llama-3.3-70b-instruct:free,deepseek/deepseek-r1:free,deepseek/deepseek-chat-v3-0324:free,google/gemma-4-31b-it:free,nvidia/nemotron-3-super-120b-a12b:free,nvidia/nemotron-3-nano-30b-a3b:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free,nvidia/nemotron-3-ultra-550b-a55b:free,openai/gpt-oss-120b:free,openai/gpt-oss-20b:free,cohere/north-mini-code:free,poolside/laguna-m.1:free,poolside/laguna-xs-2.1:free,qwen/qwen3-next-80b-a3b-instruct:free
AI_RATE_LIMIT_PER_MINUTE=60

# Firebase service account values (for Render only — keep these secret)
FIREBASE_PROJECT_ID=beastai-f0702
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n
FIREBASE_DATABASE_URL=https://beastai-f0702-default-rtdb.firebaseio.com
NODE_ENV=production
PORT=3000
# Copy this file to .env for local development. Never commit the real .env file.
# PUBLIC_CHAT=true allows the GitHub Pages frontend to use AI without requiring sign-in
PUBLIC_CHAT=true
# Show provider error details in responses for debugging
SHOW_PROVIDER_ERRORS=true
